DATABASE_URL=postgres://libratrack:libratrack@localhost:5434/libratrack?sslmode=disable
TEST_DATABASE_URL=postgres://libratrack:libratrack@localhost:5434/libratrack_test?sslmode=disable
# MIGRATIONS_PATH=migrations   # необов'язково: міграції вбудовані в бінарник
COOKIE_SECURE=true
# Перший адміністратор (створюється при старті, якщо email ще немає):
BOOTSTRAP_ADMIN_EMAIL=admin@libratrack.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
PORT=8080

# Секрет підпису JWT: мінімум 32 символи. Для продакшену згенеруйте випадковий.
JWT_SECRET=change-me-to-a-long-random-string-32chars-min
